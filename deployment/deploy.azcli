#!/bin/bash

# ============================================================================
# Azure Cloud Project Deployment Script
# Deployment Template for CSEC 3 Cloud Computing Course
# ============================================================================
# 
# This script deploys a cloud-native web application on Azure
# Modify the variables below to match your project requirements
#
# ============================================================================

set -e  # Exit on any error

# ============================================================================
# CONFIGURATION VARIABLES - UPDATE THESE FOR YOUR PROJECT
# ============================================================================

# Subscription and Authentication
SUBSCRIPTION_ID="your-subscription-id-here"
LOCATION="southeastasia"  # Change to your preferred region

# Resource Naming (use globally unique names for some resources)
RESOURCE_GROUP="rg-cloud-project"
UNIQUE_ID=$(date +%s%N | md5sum | head -c 6)  # Generate unique suffix
PROJECT_NAME="cloudproject-${UNIQUE_ID}"

# App Service Configuration
APP_SERVICE_PLAN_NAME="${PROJECT_NAME}-asp"
APP_SERVICE_NAME_1="${PROJECT_NAME}-app1"
APP_SERVICE_NAME_2="${PROJECT_NAME}-app2"
RUNTIME="node|18-lts"  # Change to your runtime: node|18-lts, python|3.11, dotnetcore|7.0, etc.

# Database Configuration
DB_SERVER_NAME="${PROJECT_NAME}-db-server"
DB_NAME="projectdb"
DB_ADMIN_USER="azureuser"
DB_ADMIN_PASSWORD="Your@Secure#Password123!"  # CHANGE THIS - Use strong password

# Storage Account Configuration
STORAGE_ACCOUNT_NAME="${PROJECT_NAME}storage${UNIQUE_ID}"  # Must be lowercase, 3-24 chars
STORAGE_CONTAINER_NAME="uploads"

# Tags for organization
TAG_ENVIRONMENT="development"
TAG_PROJECT="csec3-cloud-computing"

# ============================================================================
# HELPER FUNCTIONS
# ============================================================================

print_step() {
    echo ""
    echo "=========================================="
    echo "✓ STEP: $1"
    echo "=========================================="
}

print_info() {
    echo "ℹ️  $1"
}

print_success() {
    echo "✅ SUCCESS: $1"
}

print_error() {
    echo "❌ ERROR: $1"
}

# ============================================================================
# MAIN DEPLOYMENT SCRIPT
# ============================================================================

# Step 1: Authenticate with Azure
print_step "Authenticating with Azure"
az login
az account set --subscription "$SUBSCRIPTION_ID"
print_success "Authenticated and subscription set"

# Step 2: Create Resource Group
print_step "Creating Resource Group"
az group create \
    --name "$RESOURCE_GROUP" \
    --location "$LOCATION" \
    --tags environment="$TAG_ENVIRONMENT" project="$TAG_PROJECT"
print_success "Resource Group created: $RESOURCE_GROUP"

# Step 3: Create App Service Plan
print_step "Creating App Service Plan"
az appservice plan create \
    --name "$APP_SERVICE_PLAN_NAME" \
    --resource-group "$RESOURCE_GROUP" \
    --sku B1 \
    --is-linux \
    --tags environment="$TAG_ENVIRONMENT"
print_success "App Service Plan created: $APP_SERVICE_PLAN_NAME"

# Step 4: Deploy App Service Instances (2 for load balancing)
print_step "Deploying App Service Instance 1"
az webapp create \
    --resource-group "$RESOURCE_GROUP" \
    --plan "$APP_SERVICE_PLAN_NAME" \
    --name "$APP_SERVICE_NAME_1" \
    --runtime "$RUNTIME" \
    --tags environment="$TAG_ENVIRONMENT"
print_success "App Service 1 deployed: $APP_SERVICE_NAME_1"

print_step "Deploying App Service Instance 2"
az webapp create \
    --resource-group "$RESOURCE_GROUP" \
    --plan "$APP_SERVICE_PLAN_NAME" \
    --name "$APP_SERVICE_NAME_2" \
    --runtime "$RUNTIME" \
    --tags environment="$TAG_ENVIRONMENT"
print_success "App Service 2 deployed: $APP_SERVICE_NAME_2"

# Step 5: Create SQL Database Server
print_step "Creating SQL Database Server"
az sql server create \
    --name "$DB_SERVER_NAME" \
    --resource-group "$RESOURCE_GROUP" \
    --location "$LOCATION" \
    --admin-user "$DB_ADMIN_USER" \
    --admin-password "$DB_ADMIN_PASSWORD" \
    --tags environment="$TAG_ENVIRONMENT"
print_success "SQL Server created: $DB_SERVER_NAME"

# Step 6: Configure firewall rules to allow Azure services
print_step "Configuring SQL Database Firewall"
az sql server firewall-rule create \
    --resource-group "$RESOURCE_GROUP" \
    --server "$DB_SERVER_NAME" \
    --name "AllowAzureIps" \
    --start-ip-address "0.0.0.0" \
    --end-ip-address "0.0.0.0"
print_success "Firewall rule created for Azure services"

# Step 7: Create SQL Database
print_step "Creating SQL Database"
az sql db create \
    --resource-group "$RESOURCE_GROUP" \
    --server "$DB_SERVER_NAME" \
    --name "$DB_NAME" \
    --service-objective Basic \
    --tags environment="$TAG_ENVIRONMENT"
print_success "SQL Database created: $DB_NAME"

# Step 8: Create Storage Account
print_step "Creating Storage Account"
az storage account create \
    --resource-group "$RESOURCE_GROUP" \
    --name "$STORAGE_ACCOUNT_NAME" \
    --location "$LOCATION" \
    --sku Standard_ZRS \
    --kind StorageV2 \
    --https-only true \
    --tags environment="$TAG_ENVIRONMENT"
print_success "Storage Account created: $STORAGE_ACCOUNT_NAME"

# Step 9: Create Storage Container
print_step "Creating Storage Container"
STORAGE_KEY=$(az storage account keys list \
    --resource-group "$RESOURCE_GROUP" \
    --account-name "$STORAGE_ACCOUNT_NAME" \
    --query "[0].value" -o tsv)

az storage container create \
    --account-name "$STORAGE_ACCOUNT_NAME" \
    --name "$STORAGE_CONTAINER_NAME" \
    --account-key "$STORAGE_KEY"
print_success "Storage container created: $STORAGE_CONTAINER_NAME"

# Step 10: Configure Application Settings
print_step "Configuring App Service Application Settings"
for APP_NAME in "$APP_SERVICE_NAME_1" "$APP_SERVICE_NAME_2"; do
    az webapp config appsettings set \
        --resource-group "$RESOURCE_GROUP" \
        --name "$APP_NAME" \
        --settings \
            "DB_SERVER=$DB_SERVER_NAME.database.windows.net" \
            "DB_NAME=$DB_NAME" \
            "DB_USER=$DB_ADMIN_USER" \
            "STORAGE_ACCOUNT=$STORAGE_ACCOUNT_NAME" \
            "STORAGE_CONTAINER=$STORAGE_CONTAINER_NAME"
done
print_success "Application settings configured for both instances"

# Step 11: Enable HTTPS
print_step "Enabling HTTPS for App Services"
for APP_NAME in "$APP_SERVICE_NAME_1" "$APP_SERVICE_NAME_2"; do
    az webapp update \
        --resource-group "$RESOURCE_GROUP" \
        --name "$APP_NAME" \
        --https-only true
done
print_success "HTTPS enabled for both instances"

# ============================================================================
# DEPLOYMENT SUMMARY
# ============================================================================

print_step "DEPLOYMENT COMPLETE - SUMMARY"
echo ""
echo "Resource Group:          $RESOURCE_GROUP"
echo "Location:                $LOCATION"
echo "Project Name:            $PROJECT_NAME"
echo ""
echo "Web Applications:"
echo "  - App Service 1: https://${APP_SERVICE_NAME_1}.azurewebsites.net"
echo "  - App Service 2: https://${APP_SERVICE_NAME_2}.azurewebsites.net"
echo ""
echo "Database:"
echo "  - Server: $DB_SERVER_NAME.database.windows.net"
echo "  - Database: $DB_NAME"
echo ""
echo "Storage Account: $STORAGE_ACCOUNT_NAME"
echo "Storage Container: $STORAGE_CONTAINER_NAME"
echo ""
print_info "Next Steps:"
echo "  1. Deploy your application code to the App Services"
echo "  2. Update database connection strings as needed"
echo "  3. Run database migrations"
echo "  4. Test application functionality"
echo "  5. Set up monitoring and alerts (optional)"
echo ""
print_info "To view all resources:"
echo "  az resource list --resource-group $RESOURCE_GROUP --output table"
echo ""
print_info "To delete all resources (when done):"
echo "  az group delete --name $RESOURCE_GROUP --yes --no-wait"
echo ""

print_success "Deployment script completed successfully!"
