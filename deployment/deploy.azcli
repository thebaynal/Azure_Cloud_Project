#!/bin/bash
# MaScan Azure Deployment Script
# Automated deployment of Flask app to Azure App Service
# Usage: ./deploy.azcli

set -e

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# ============================================================================
# Configuration
# ============================================================================

RESOURCE_GROUP="mascan-rg"
LOCATION="eastus"
ACR_NAME="mascanregistry1111"
APP_PLAN_NAME="mascan-plan"
APP_NAME="mascan-app"
SKU="B1"
DOCKER_IMAGE="mascan:latest"

# ============================================================================
# Functions
# ============================================================================

print_step() {
    echo -e "${GREEN}[$(date +'%H:%M:%S')]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

# ============================================================================
# Step 1: Authenticate with Azure
# ============================================================================

print_step "Step 1: Authenticating with Azure..."
az login

# Verify subscription
SUBSCRIPTION=$(az account show --query id -o tsv)
print_step "Using subscription: $SUBSCRIPTION"

# ============================================================================
# Step 2: Create Resource Group
# ============================================================================

print_step "Step 2: Creating resource group '$RESOURCE_GROUP' in $LOCATION..."
az group create \
    --name "$RESOURCE_GROUP" \
    --location "$LOCATION" \
    --output table

# ============================================================================
# Step 3: Create Container Registry
# ============================================================================

print_step "Step 3: Creating Azure Container Registry..."
az acr create \
    --resource-group "$RESOURCE_GROUP" \
    --name "$ACR_NAME" \
    --sku Basic \
    --admin-enabled true \
    --output table

# Get ACR credentials
print_step "Retrieving ACR credentials..."
ACR_CREDS=$(az acr credential show --name "$ACR_NAME")
ACR_USER=$(echo "$ACR_CREDS" | jq -r '.username')
ACR_PASS=$(echo "$ACR_CREDS" | jq -r '.passwords[0].value')
ACR_URL="$ACR_NAME.azurecr.io"

print_step "ACR URL: $ACR_URL"
print_step "ACR Username: $ACR_USER"

# ============================================================================
# Step 4: Build and Push Docker Image
# ============================================================================

print_step "Step 4: Building Docker image..."
docker build -t "$ACR_URL/$DOCKER_IMAGE" .

print_step "Logging into Azure Container Registry..."
az acr login --name "$ACR_NAME"

print_step "Pushing Docker image to ACR..."
docker push "$ACR_URL/$DOCKER_IMAGE"

# ============================================================================
# Step 5: Create App Service Plan
# ============================================================================

print_step "Step 5: Creating App Service Plan..."
az appservice plan create \
    --name "$APP_PLAN_NAME" \
    --resource-group "$RESOURCE_GROUP" \
    --sku "$SKU" \
    --is-linux \
    --output table

# ============================================================================
# Step 6: Create Web App
# ============================================================================

print_step "Step 6: Creating Web App..."
az webapp create \
    --resource-group "$RESOURCE_GROUP" \
    --plan "$APP_PLAN_NAME" \
    --name "$APP_NAME" \
    --deployment-container-image-name "$ACR_URL/$DOCKER_IMAGE" \
    --output table

# ============================================================================
# Step 7: Configure Environment Variables
# ============================================================================

print_step "Step 7: Configuring environment variables..."

# Generate a secure SECRET_KEY if not provided
if [ -z "$SECRET_KEY" ]; then
    SECRET_KEY=$(python3 -c "import secrets; print(secrets.token_hex(32))")
    print_warning "Generated new SECRET_KEY: $SECRET_KEY"
fi

az webapp config appsettings set \
    --resource-group "$RESOURCE_GROUP" \
    --name "$APP_NAME" \
    --settings \
        SECRET_KEY="$SECRET_KEY" \
        DB_PATH="/home/data/mascan_attendance.db" \
        SESSION_FILE_DIR="/home/flask_session" \
        WEBSITES_PORT=8000 \
    --output table

# ============================================================================
# Step 8: Enable Persistent Storage
# ============================================================================

print_step "Step 8: Enabling persistent storage..."
az webapp config appsettings set \
    --resource-group "$RESOURCE_GROUP" \
    --name "$APP_NAME" \
    --settings WEBSITES_ENABLE_APP_SERVICE_STORAGE=true \
    --output table

# ============================================================================
# Step 9: Configure Container Registry Authentication
# ============================================================================

print_step "Step 9: Configuring container registry authentication..."
az webapp config container set \
    --name "$APP_NAME" \
    --resource-group "$RESOURCE_GROUP" \
    --docker-custom-image-name "$ACR_URL/$DOCKER_IMAGE" \
    --docker-registry-server-url "https://$ACR_URL" \
    --docker-registry-server-user "$ACR_USER" \
    --docker-registry-server-password "$ACR_PASS" \
    --output table

# ============================================================================
# Step 10: Verify Deployment
# ============================================================================

print_step "Step 10: Verifying deployment..."
APP_URL=$(az webapp show \
    --resource-group "$RESOURCE_GROUP" \
    --name "$APP_NAME" \
    --query defaultHostName \
    --output tsv)

print_step "Waiting for app to be ready (30 seconds)..."
sleep 30

HTTP_STATUS=$(curl -s -o /dev/null -w "%{http_code}" "https://$APP_URL/")
if [ "$HTTP_STATUS" -eq 200 ]; then
    print_step "✅ Deployment successful!"
    print_step "App is running at: https://$APP_URL"
else
    print_warning "App returned HTTP $HTTP_STATUS - may still be starting up"
    print_step "App URL: https://$APP_URL"
fi

# ============================================================================
# Summary
# ============================================================================

print_step "================================================"
print_step "Deployment Summary"
print_step "================================================"
print_step "Resource Group: $RESOURCE_GROUP"
print_step "Location: $LOCATION"
print_step "App Service: $APP_NAME"
print_step "App URL: https://$APP_URL"
print_step "Container Registry: $ACR_NAME"
print_step "Docker Image: $ACR_URL/$DOCKER_IMAGE"
print_step "App Service Plan: $APP_PLAN_NAME"
print_step "================================================"

print_step "To view logs:"
print_step "  az webapp log tail --resource-group $RESOURCE_GROUP --name $APP_NAME"

print_step "To restart the app:"
print_step "  az webapp restart --resource-group $RESOURCE_GROUP --name $APP_NAME"

print_step "To open in browser:"
print_step "  az webapp browse --resource-group $RESOURCE_GROUP --name $APP_NAME"

print_step "Deployment complete! 🎉"
